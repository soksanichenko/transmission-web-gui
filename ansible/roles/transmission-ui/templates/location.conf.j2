# Proxied before the static location to take precedence
location /transmission-ui/api/ {
{% for network in transmission_ui_local_networks %}
    allow {{ network }};
{% endfor %}
    deny all;
    # Resolved through Docker's DNS per request, so a stopped/recreated
    # container can't stop nginx itself from starting. A variable proxy_pass
    # can't strip the location prefix, hence the rewrite.
    resolver              127.0.0.11 valid=10s ipv6=off;
    set                   $transmission_ui_config_api_host "{{ transmission_ui_config_api_name }}";
    rewrite               ^/transmission-ui/api/(.*)$ /$1 break;
    proxy_pass            http://$transmission_ui_config_api_host:{{ transmission_ui_config_api_port }};
    proxy_set_header      Host              $host;
    proxy_set_header      X-Real-IP         $client_real_ip;
    proxy_set_header      X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header      X-Forwarded-Proto $scheme;
    proxy_read_timeout    10s;
    proxy_connect_timeout 5s;
}

location /transmission-ui/ {
{% for network in transmission_ui_local_networks %}
    allow {{ network }};
{% endfor %}
    deny all;
    alias      /usr/share/nginx/html/static/transmission-ui/;
    index      index.html;
    try_files  $uri $uri/ =404;
    add_header Cache-Control "no-cache" always;
}
